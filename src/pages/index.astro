---
// Homepage (Astro rewrite in progress). The full original page stays live at /legacy.html for side-by-side comparison.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Statement from "../components/Statement.astro";
import Comments from "../components/Comments.astro";
import Personal from "../components/Personal.astro";
import Cloud from "../components/Cloud.astro";
import Faq from "../components/Faq.astro";
import { MOBILE_MAX_WIDTH, videoUrl } from "../config/frames";
import { SCENES } from "../config/scenes";

// The first hero video starts downloading with the HTML instead of waiting for the hero script; `media` picks the
// desktop or mobile encode. crossorigin matches the fetch() in VideoSequence so the browser reuses this download
const firstSequence = SCENES[0].sequence;
---

<BaseLayout>
  <Fragment slot="head">
    <link rel="preload" as="fetch" crossorigin="anonymous" href={videoUrl(firstSequence, false)} media={`(min-width: ${MOBILE_MAX_WIDTH + 1}px)`} />
    <link rel="preload" as="fetch" crossorigin="anonymous" href={videoUrl(firstSequence, true)} media={`(max-width: ${MOBILE_MAX_WIDTH}px)`} />
  </Fragment>
  <Hero />
  <Features />
  <Comments />
  <Statement />
  <Personal />
  <Cloud />
  <Faq />
</BaseLayout>
