---
// Homepage: being redesigned. Opens with the deposit hero and offer (from the Shopify home page), then the scroll-driven
// frame stage; new sections go after it inside BaseLayout.
import BaseLayout from "../layouts/BaseLayout.astro";
import DepositHero from "../components/DepositHero.astro";
import DepositOffer from "../components/DepositOffer.astro";
import FrameStage from "../components/FrameStage.astro";
import AiMacEffect from "../components/AiMacEffect.astro";
import PrivateAgent from "../components/PrivateAgent.astro";
import TruePower from "../components/TruePower.astro";
import TokkeyCompare from "../components/TokkeyCompare.astro";
import ProductViewer from "../components/ProductViewer.astro";
import FeatureCarousel from "../components/FeatureCarousel.astro";
import RentingStatement from "../components/RentingStatement.astro";
import PersonalPrivacy from "../components/PersonalPrivacy.astro";
import Faq from "../components/Faq.astro";
import ReserveEmail from "../components/ReserveEmail.astro";
import { FAQ_ITEMS } from "../config/faq";
import { StructuredData } from "../config/seo";

// Structured data for Google: brand, product brief and the FAQ shown at the bottom of the page
const schemas = [StructuredData.webSite(), StructuredData.organization(), StructuredData.product(), StructuredData.faqPage(FAQ_ITEMS)];
---

<BaseLayout navOverHero>
  <!-- Fonts for the hero "Intelligence" dance only (approved exception to Inter + Commit Mono, see HeroTitleScene) -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;1,400&family=Cormorant+Garamond:wght@300&family=EB+Garamond:ital,wght@1,400&family=Bodoni+Moda:opsz,wght@6..96,400&family=DM+Serif+Display:ital@1&family=Josefin+Slab:wght@300&family=Space+Grotesk:wght@300&family=Bebas+Neue&family=Courier+Prime&display=swap"
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schemas)} is:inline />
  <DepositHero />
  <DepositOffer />
  <FrameStage>
    <!-- Hero headline over the first frames; scrolls away as the stage starts playing (HeroTitleScene).
         Figma 1157:61: Inter Medium 128px / 0.95 on a 1920 frame (scales with the viewport), top at 31%, 0.12em word gap (two lines on mobile), round accent dot -->
    <h1
      data-hero-title
      aria-label="Own Your Intelligence"
      class="pointer-events-none absolute inset-x-0 top-[31%] px-gutter-sm text-center text-hero-sm font-medium text-white md:px-gutter md:text-[clamp(48px,6.667vw,128px)] md:leading-[0.95]"
    >
      <span data-ref="inner" class="block"
        ><span class="block whitespace-nowrap tracking-[-0.035em] text-white/55 md:inline">Own Your</span>
        <span data-ref="dance" class="whitespace-nowrap tracking-[-0.03em] md:ml-[0.12em]">Intelligence</span><span class="dot" aria-hidden="true"></span
        ></span
      >
    </h1>
    <AiMacEffect />
    <PrivateAgent />
    <TruePower />
    <TokkeyCompare />
    <ProductViewer />
  </FrameStage>
  <FeatureCarousel />
  <RentingStatement />
  <PersonalPrivacy />
  <Faq />
  <ReserveEmail />
</BaseLayout>

<script>
  import { HeroTitleScene } from "../scripts/scenes/HeroTitleScene";
  const title = document.querySelector<HTMLElement>("[data-hero-title]");
  const section = title?.closest<HTMLElement>("[data-frame-stage]");
  if (title && section) new HeroTitleScene(title, section);
</script>
