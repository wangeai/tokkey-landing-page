---
// Software page "Compatibility check" section (Figma: S4 Compatibility check): headline, the Mac's spec pills and a
// table of models comparing speed on the Mac alone with speed through Tokkey. Sizes are Figma px via --fx
// (src/styles/global.css); below 1200px the table keeps its column widths and scrolls sideways inside its box.
// Content: src/config/software.ts. Toggle: src/scripts/CompatibilityTable.ts.
import { COMPAT_MODELS, COMPAT_SPECS, COMPAT_VISIBLE_ROWS } from "../config/software";
---

<section
  id="compatibility"
  data-compatibility
  class="bg-white px-gutter-sm py-24 text-[#16191a] md:px-[calc(120*var(--fx))] md:pt-[calc(120*var(--fx))] md:pb-[calc(96*var(--fx))]"
>
  <p data-reveal class="label text-[#6b6f69] md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">Compatibility check</p>
  <h2 data-reveal class="mt-2 text-h2-sm font-bold md:mt-[calc(8*var(--fx))] md:text-[calc(64*var(--fx))]/[calc(72*var(--fx))]">
    Can your Mac run it<span class="period">.</span>
  </h2>
  <p data-reveal class="mt-6 text-lead text-[#6b6f69] md:mt-[calc(24*var(--fx))] md:text-[calc(24*var(--fx))]/[calc(32*var(--fx))]">
    Pick your chip and memory. See what runs, with and without Tokkey.
  </p>

  <!-- The Mac being checked -->
  <ul data-reveal class="mt-8 flex flex-wrap gap-3 md:mt-[calc(48*var(--fx))] md:gap-[calc(16*var(--fx))]" aria-label="Your Mac">
    {
      COMPAT_SPECS.map((spec) => (
        <li class="spec" style={`--w:${spec.width}`}>
          <span class="spec-label">{spec.label}</span>
          <b class="font-medium">{spec.value}</b>
          {spec.signal && <i class="signal ml-auto" aria-hidden="true" />}
        </li>
      ))
    }
  </ul>

  <div data-reveal class="board mt-10 md:mt-[calc(40*var(--fx))]">
    <div class="overflow-x-auto">
      <table>
        <colgroup>
          <col class="w-[calc(440*var(--fx))]" />
          <col class="w-[calc(160*var(--fx))]" />
          <col class="w-[calc(160*var(--fx))]" />
          <col class="w-[calc(320*var(--fx))]" />
          <col class="w-[calc(280*var(--fx))]" />
          <col />
        </colgroup>
        <thead>
          <tr>
            <th>Model</th>
            <th>Size</th>
            <th>Memory</th>
            <th>Your Mac alone</th>
            <th>With Tokkey</th>
            <th>Grade</th>
          </tr>
        </thead>
        <tbody>
          {
            COMPAT_MODELS.map((model, i) => (
              <tr hidden={i >= COMPAT_VISIBLE_ROWS} data-extra={i >= COMPAT_VISIBLE_ROWS ? "" : undefined}>
                <td class="speed font-semibold">{model.name}</td>
                <td class="text-[#6b6f69]">{model.size}</td>
                <td class="text-[#6b6f69]">{model.memory}</td>
                <td>
                  {model.alone ? (
                    <span class="speed text-[#6b6f69]">{model.alone}</span>
                  ) : (
                    <>
                      <span class="speed block font-semibold">Won’t fit</span>
                      <span class="tag mt-[calc(24*var(--fx))] border border-[rgb(22_25_26/18%)] tracking-[0.6px] text-[#6b6f69]">
                        Not enough memory
                      </span>
                    </>
                  )}
                </td>
                <td>
                  <span class="speed with font-semibold">{model.withTokkey}</span>
                </td>
                <td class="whitespace-nowrap">
                  <span class:list={["tag tracking-[0.8px]", model.grade === "S" ? "bg-[rgb(22_25_26/90%)] text-white" : "bg-[rgb(22_25_26/7%)]"]}>
                    Grade {model.grade}
                  </span>
                  {model.boost && <b class="ml-[calc(24*var(--fx))] font-semibold">{model.boost}</b>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="flex justify-center pb-[calc(41*var(--fx))]">
      <button type="button" data-ref="show-all" aria-expanded="false" class="show-all">
        <span data-ref="label">Show all models</span><span aria-hidden="true">▾</span>
      </button>
    </div>
  </div>
</section>

<script>
  import { ScrollReveal } from "../scripts/ScrollReveal";
  import { CompatibilityTable } from "../scripts/CompatibilityTable";
  const section = document.querySelector<HTMLElement>("[data-compatibility]");
  if (section) {
    ScrollReveal.section(section);
    new CompatibilityTable(section);
  }
</script>

<style>
  /* Spec pill (Figma: box, 56 tall): mono label then value 24 apart, Figma width as a minimum */
  .spec {
    display: flex;
    align-items: center;
    gap: calc(24 * var(--fx));
    min-width: calc(var(--w) * var(--fx));
    height: calc(56 * var(--fx));
    padding-inline: calc(24 * var(--fx));
    border: 1px solid rgb(22 25 26 / 12%);
    border-radius: calc(28 * var(--fx));
    background: rgb(22 25 26 / 4%);
    font-size: calc(16 * var(--fx));
    line-height: calc(24 * var(--fx));
  }
  .spec-label {
    color: rgb(22 25 26 / 72%);
    font-family: var(--font-mono);
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }
  .signal {
    width: calc(8 * var(--fx));
    height: calc(8 * var(--fx));
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Frosted table box (Figma: Compatibility table, 1680 wide, 24 radius) */
  .board {
    overflow: hidden;
    border: 1px solid rgb(22 25 26 / 12%);
    border-radius: calc(24 * var(--fx));
    background: rgb(22 25 26 / 3%);
    backdrop-filter: blur(15px);
  }

  table {
    width: 100%;
    min-width: calc(1678 * var(--fx));
    table-layout: fixed;
    border-collapse: collapse;
    text-align: left;
    font-size: calc(16 * var(--fx));
    line-height: calc(32 * var(--fx));
  }
  /* First column starts 39 in; header 27 / 28 around the label, rows 24 above their content and 55 below */
  th:first-child,
  td:first-child {
    padding-left: calc(39 * var(--fx));
  }
  th {
    padding-block: calc(23 * var(--fx)) calc(24 * var(--fx));
    border-bottom: 1px solid rgb(22 25 26 / 7%);
    color: #6b6f69;
    font-family: var(--font-mono);
    font-weight: 400;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  td {
    padding-block: calc(24 * var(--fx)) calc(55 * var(--fx));
    vertical-align: top;
  }
  tr + tr td {
    border-top: 1px solid rgb(22 25 26 / 5%);
  }
  /* Last visible row sits 39 above the button */
  tbody tr:not([hidden]):has(+ tr[hidden]) td,
  tbody tr:last-child td {
    padding-bottom: calc(39 * var(--fx));
  }

  /* 24px figures (model name and speeds) */
  .speed {
    font-size: calc(24 * var(--fx));
  }
  /* Accent dot 24 left of the Tokkey speed */
  .with {
    position: relative;
  }
  .with::before {
    content: "";
    position: absolute;
    top: 50%;
    left: calc(-24 * var(--fx));
    width: calc(8 * var(--fx));
    height: calc(8 * var(--fx));
    border-radius: 50%;
    background: var(--color-accent);
    translate: 0 -50%;
  }

  /* Mono pill: grade and "Not enough memory" (32 tall) */
  .tag {
    display: inline-flex;
    align-items: center;
    height: calc(32 * var(--fx));
    padding-inline: calc(16 * var(--fx));
    border-radius: calc(16 * var(--fx));
    font-family: var(--font-mono);
    line-height: calc(24 * var(--fx));
    text-transform: uppercase;
    white-space: nowrap;
  }

  .show-all {
    display: inline-flex;
    align-items: center;
    gap: calc(12 * var(--fx));
    height: calc(48 * var(--fx));
    padding-inline: calc(24 * var(--fx));
    border-radius: calc(24 * var(--fx));
    background: rgb(22 25 26 / 5%);
    font-size: calc(16 * var(--fx));
    line-height: calc(24 * var(--fx));
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .show-all:hover {
    background: rgb(22 25 26 / 9%);
  }
  .show-all:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Mobile: narrower columns (the table still scrolls sideways) */
  @media (width < 768px) {
    table {
      min-width: 880px;
    }
    col:nth-child(1) {
      width: 220px;
    }
    col:nth-child(2),
    col:nth-child(3) {
      width: 96px;
    }
    col:nth-child(4),
    col:nth-child(5) {
      width: 180px;
    }
    th:first-child,
    td:first-child {
      padding-left: 20px;
    }
    td {
      padding-bottom: 32px;
    }
  }
</style>
