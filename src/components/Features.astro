---
// Features section: a horizontal carousel of five cards (models, game demo, light ring, lid closed, private memory), each
// with a caption below, driven by the prev/next buttons, drag or touch.
// Driven by src/scripts/scenes/FeaturesScene.ts; elements tagged data-ref are looked up by name there.
// Content lives in src/config/features.ts and src/config/games.ts.
import { DEMO_GAME_COUNT, MODEL_FOOTPRINTS, SLIDE_CAPTIONS } from "../config/features";
import { GAME_THUMB, GAME_VIEW, GAMES } from "../config/games";

// Chevron paths for the carousel buttons (46px button, Figma "Button / Previous" and "Button / Next")
const arrows = { prev: "M26 17l-6 6 6 6", next: "M20 17l6 6-6 6" };
---

<section
  id="features"
  data-features
  aria-roledescription="carousel"
  aria-label="Tokkey features"
  class="relative flex flex-col overflow-hidden bg-black pt-24 pb-10 text-white [--edge:max(16px,4.5vw)] md:min-h-svh md:pt-[calc(112*var(--fx))] md:pb-[calc(44*var(--fx))]"
>
  <div data-ref="carousel" class="track relative">
    <!-- 1. Run large AI models: memory footprint per model; clicking a row highlights it -->
    <figure class="slide" aria-roledescription="slide" aria-label="1 of 5">
      <div class="card flex flex-col justify-center gap-3 px-3.5 md:gap-[calc(16*var(--fx))] md:px-[calc(22*var(--fx))]">
        {
          MODEL_FOOTPRINTS.map((model, i) => (
            <div role="button" tabindex="0" aria-pressed={i === 0 ? "true" : "false"} data-model-card class="model-row">
              <small class="font-mono text-[calc(10*var(--fx))] leading-[calc(16*var(--fx))] tracking-[0.08em] text-white/60 uppercase">{model.params}</small>
              <div class="mt-[calc(8*var(--fx))] flex items-center gap-[calc(8*var(--fx))]">
                <img src={`/assets/icons/models/${model.icon}.svg`} width="24" height="24" class="size-[calc(24*var(--fx))]" alt="" aria-hidden="true" />
                <h3 class="text-[calc(16*var(--fx))] leading-[calc(24*var(--fx))] font-semibold tracking-[-0.01em]">{model.name}</h3>
              </div>
              <div class="mt-[calc(16*var(--fx))] flex flex-wrap items-baseline gap-x-[calc(8*var(--fx))]">
                <b class="model-figure" style={`--tint:${model.tint}`}>{model.withTokkey}</b>
                <span class="text-[calc(12*var(--fx))] leading-[calc(16*var(--fx))] text-white/60">of memory with Tokkey</span>
                <em class="ml-auto font-mono text-[calc(10*var(--fx))] leading-[calc(16*var(--fx))] tracking-[0.04em] text-white/50 not-italic">vs {model.without} without</em>
              </div>
            </div>
          ))
        }
      </div>
      <figcaption class="caption"><span>{SLIDE_CAPTIONS[0].lead}</span> {SLIDE_CAPTIONS[0].text}</figcaption>
    </figure>

    <!-- 2. Game demo: GameDemo plays the picked game in the big view and all of them in the thumbnails -->
    <figure class="slide" aria-roledescription="slide" aria-label="2 of 5">
      <div data-ref="games" class="card flex flex-col gap-3 p-3.5 md:gap-[calc(16*var(--fx))] md:p-[calc(22*var(--fx))]">
        <div class="relative min-h-0 flex-1 overflow-hidden rounded-[calc(24*var(--fx))] bg-black">
          <canvas data-game-view width={GAME_VIEW.width} height={GAME_VIEW.height} class="block size-full object-cover"></canvas>
          <div class="glass absolute bottom-3 left-3 bg-black/45 px-4 py-3 md:bottom-[calc(16*var(--fx))] md:left-[calc(16*var(--fx))] md:w-[calc(344*var(--fx))] md:px-[calc(22*var(--fx))] md:py-[calc(14*var(--fx))]">
            <div class="font-mono text-[calc(10*var(--fx))] leading-[calc(16*var(--fx))] tracking-[0.08em] text-white/70 uppercase">
              Now playing · <span data-game-title></span>
            </div>
            <div data-game-title class="mt-[calc(8*var(--fx))] text-[calc(20*var(--fx))] leading-[calc(24*var(--fx))] font-semibold tracking-[-0.02em]"></div>
            <span class="chip mt-[calc(8*var(--fx))] max-md:hidden"><i></i>Qwen3.6 35B-A3B · local · 0 tokens</span>
          </div>
        </div>
        <div class="grid grid-cols-4 gap-2 md:gap-[calc(16*var(--fx))]">
          {
            GAMES.slice(0, DEMO_GAME_COUNT).map((game) => (
              <button type="button" data-game aria-pressed="false" class="game-thumb">
                <canvas width={GAME_THUMB.width} height={GAME_THUMB.height} class="block h-12 w-full object-cover md:h-[calc(84*var(--fx))]" />
                <b>{game.name}</b>
              </button>
            ))
          }
        </div>
      </div>
      <figcaption class="caption"><span>{SLIDE_CAPTIONS[1].lead}</span> {SLIDE_CAPTIONS[1].text}</figcaption>
    </figure>

    <!-- 3. Light guidance: the key's back with its light ring breathing (LightRing) -->
    <figure class="slide" aria-roledescription="slide" aria-label="3 of 5">
      <div class="card">
        <img src="/assets/images/k4_close.webp" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 size-full object-cover" />
        <div class="light-shade absolute inset-0"></div>
        <div class="absolute top-[26.4%] left-1/2 aspect-[360/264] w-[52%] -translate-x-1/2">
          <img data-ref="ringPlate" src="/assets/images/k4_plate.webp" alt="Tokkey back, light ring" loading="lazy" class="size-full object-contain" />
          <div data-ref="ringGlow" class="ring-glow"></div>
        </div>
        <div class="glass absolute bottom-3 left-3 w-[calc(260*var(--fx))] bg-black/50 px-[calc(18*var(--fx))] pt-[calc(12*var(--fx))] pb-[calc(14*var(--fx))] md:bottom-[calc(22*var(--fx))] md:left-[calc(22*var(--fx))] md:rounded-[calc(18*var(--fx))]">
          <div class="font-mono text-[calc(10.5*var(--fx))] leading-[calc(16*var(--fx))] tracking-[0.08em] text-white/60 uppercase">Light states</div>
          <div class="mt-[calc(6*var(--fx))] flex items-center gap-[calc(8*var(--fx))]">
            <i class="light-dot"></i>
            <b class="text-[calc(16*var(--fx))] leading-[calc(22*var(--fx))] font-semibold">Done</b>
            <em class="ml-[calc(14*var(--fx))] font-mono text-[calc(10*var(--fx))] leading-[calc(14*var(--fx))] tracking-[0.04em] text-white/60 not-italic">WHITE PULSE</em>
          </div>
        </div>
      </div>
      <figcaption class="caption"><span>{SLIDE_CAPTIONS[2].lead}</span> {SLIDE_CAPTIONS[2].text}</figcaption>
    </figure>

    <!-- 4. Lid closed -->
    <figure class="slide" aria-roledescription="slide" aria-label="4 of 5">
      <div class="card">
        <img
          src="/assets/images/lid.png"
          alt="MacBook lid closed with Tokkey plugged in"
          width="1800"
          height="1237"
          loading="lazy"
          class="absolute top-[7.1%] left-[6.8%] h-[77.7%] w-[86.1%] object-contain"
        />
        <div class="glass absolute right-3 bottom-3 w-[calc(300*var(--fx))] max-w-[calc(100%-24px)] bg-black/50 px-[calc(22*var(--fx))] py-[calc(14*var(--fx))] md:right-[calc(22*var(--fx))] md:bottom-[calc(22*var(--fx))]">
          <div class="font-mono text-[calc(10*var(--fx))] leading-[calc(16*var(--fx))] tracking-[0.08em] text-white/70 uppercase">Lid closed</div>
          <div class="mt-[calc(8*var(--fx))] text-[calc(20*var(--fx))] leading-[calc(24*var(--fx))] font-semibold tracking-[-0.02em]">Still working<span class="period">.</span></div>
          <span class="chip mt-[calc(2*var(--fx))]"><i></i>Agent running · 04:12:09 uptime</span>
        </div>
      </div>
      <figcaption class="caption"><span>{SLIDE_CAPTIONS[3].lead}</span> {SLIDE_CAPTIONS[3].text}</figcaption>
    </figure>

    <!-- 5. Private memory -->
    <figure class="slide" aria-roledescription="slide" aria-label="5 of 5">
      <div class="card">
        <img src="/assets/images/s4_memory.webp" alt="A hand plugging Tokkey into a laptop" width="463" height="444" loading="lazy" class="absolute inset-0 size-full object-cover" />
        <div class="memory-shade absolute inset-0"></div>
      </div>
      <figcaption class="caption"><span>{SLIDE_CAPTIONS[4].lead}</span> {SLIDE_CAPTIONS[4].text}</figcaption>
    </figure>
  </div>

  <div class="relative mt-8 flex justify-end gap-[calc(8*var(--fx))] pr-(--edge) md:mt-auto md:pt-[calc(40*var(--fx))] md:pr-[5vw]">
    <button type="button" data-ref="carouselPrev" class="carousel-button" aria-label="Previous">
      <svg viewBox="0 0 46 46" width="46" height="46" class="size-[calc(46*var(--fx))]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={arrows.prev} /></svg>
    </button>
    <button type="button" data-ref="carouselNext" class="carousel-button" aria-label="Next">
      <svg viewBox="0 0 46 46" width="46" height="46" class="size-[calc(46*var(--fx))]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={arrows.next} /></svg>
    </button>
  </div>
</section>

<script>
  import { FeaturesScene } from "../scripts/scenes/FeaturesScene";
  const section = document.querySelector<HTMLElement>("[data-features]");
  if (section) new FeaturesScene(section);
</script>

<style>
  /* Sizes are in Figma pixels via --fx (src/styles/global.css) */
  /* ---------- Track: native horizontal scroll, cards snap to the left edge ---------- */
  .track {
    display: flex;
    gap: calc(24 * var(--fx));
    padding-inline: var(--edge);
    scroll-padding-inline: var(--edge);
    overflow: auto hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track[data-dragging] {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .slide {
    flex: none;
    width: min(calc(691 * var(--fx)), calc(100vw - 48px));
    scroll-snap-align: start;
  }
  .card {
    position: relative;
    height: 520px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: calc(32 * var(--fx));
    background: #0a0a0a;
  }
  @media (width >= 768px) {
    .card {
      height: calc(664 * var(--fx));
    }
  }
  /* Caption: white lead sentence, grey rest (Figma #86868b) */
  .caption {
    margin-top: calc(24 * var(--fx));
    padding-inline: calc(4 * var(--fx));
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.01em;
    color: #86868b;
  }
  .caption span {
    color: #fff;
  }
  @media (width >= 768px) {
    .caption {
      font-size: calc(20 * var(--fx));
      line-height: calc(32 * var(--fx));
    }
  }

  /* ---------- Shared glass pieces ---------- */
  .glass {
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: calc(24 * var(--fx));
    backdrop-filter: blur(10px);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--fx));
    height: calc(24 * var(--fx));
    padding: 0 calc(12 * var(--fx)) 0 calc(10 * var(--fx));
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: calc(12 * var(--fx));
    background: rgb(0 0 0 / 40%);
    font: calc(10 * var(--fx))/calc(16 * var(--fx)) var(--font-mono);
    white-space: nowrap;
  }
  .chip i {
    width: calc(8 * var(--fx));
    height: calc(8 * var(--fx));
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* ---------- Card 1: model rows ---------- */
  .model-row {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    max-height: calc(192 * var(--fx));
    padding: 0 18px;
    border: 1px solid rgb(255 255 255 / 6%);
    border-radius: calc(24 * var(--fx));
    background: #1c1c1e;
    cursor: pointer;
    transition: background 0.4s, border-color 0.4s;
  }
  .model-row[aria-pressed="true"] {
    border-color: rgb(255 255 255 / 14%);
    background: linear-gradient(180deg, #34343c, #202024);
  }
  .model-row:focus-visible {
    outline: 1px solid var(--color-accent);
  }
  @media (width >= 768px) {
    .model-row {
      padding: 0 calc(30 * var(--fx));
    }
  }
  /* "~5 GB": vertical gradient from the model's tint to white */
  .model-figure {
    font-size: calc(24 * var(--fx));
    line-height: calc(32 * var(--fx));
    font-weight: 600;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, var(--tint), #fff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---------- Card 2: game thumbnails ---------- */
  .game-thumb {
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: calc(16 * var(--fx));
    background: #0d0d10;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.3s;
  }
  .game-thumb[aria-pressed="true"] {
    border-color: rgb(255 255 255 / 70%);
  }
  .game-thumb:focus-visible {
    outline: 1px solid var(--color-accent);
  }
  .game-thumb b {
    display: block;
    overflow: hidden;
    padding: calc(7 * var(--fx)) calc(14 * var(--fx)) calc(8 * var(--fx));
    font-size: calc(12 * var(--fx));
    line-height: calc(16 * var(--fx));
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: rgb(255 255 255 / 60%);
  }
  .game-thumb[aria-pressed="true"] b {
    color: #fff;
  }
  @media (width < 768px) {
    .game-thumb b {
      padding-inline: 8px;
      font-size: 10px;
    }
  }

  /* ---------- Card 3: light ring ---------- */
  .light-shade {
    background: linear-gradient(180deg, rgb(0 0 0 / 55%), rgb(0 0 0 / 88%));
  }
  /* Blurred glow over the ring (centered on it in k4_plate); LightRing animates its opacity and gradient */
  .ring-glow {
    position: absolute;
    top: 53%;
    left: 38%;
    width: 42%;
    aspect-ratio: 1;
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%);
    mix-blend-mode: screen;
    filter: blur(calc(22 * var(--fx)));
    pointer-events: none;
    transition: opacity 0.6s;
  }
  .light-dot {
    flex: none;
    width: calc(8 * var(--fx));
    height: calc(8 * var(--fx));
    border-radius: 50%;
    background: #fff;
    animation: light-pulse 2.8s ease-in-out infinite;
  }
  @keyframes light-pulse {
    0%,
    100% {
      box-shadow: 0 0 4px rgb(255 255 255 / 40%);
    }
    50% {
      box-shadow: 0 0 12px #fff;
    }
  }

  /* ---------- Card 5: private memory ---------- */
  .memory-shade {
    background: linear-gradient(180deg, rgb(0 0 0 / 30%), rgb(0 0 0 / 6%) 38%, rgb(0 0 0 / 50%));
  }

  /* ---------- Prev / next ---------- */
  .carousel-button {
    border-radius: 50%;
    background: #2a2a2c;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .carousel-button:hover:not(:disabled) {
    background: #3a3a3c;
  }
  .carousel-button:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 2px;
  }
  .carousel-button:disabled {
    color: rgb(255 255 255 / 40%);
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .light-dot {
      animation: none;
    }
  }
</style>
