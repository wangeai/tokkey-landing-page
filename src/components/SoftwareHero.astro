---
// Software page hero (Figma: Software · D · 01_hero, node 1166:286): "Own your AI." centred over the dark backdrop with
// a drifting ambient character field, two pill CTAs, and a 160px fade into the paper-coloured features below. Sizes
// are Figma px via --fx (the 1920 frame scales with the viewport). Field: src/scripts/AmbientField.ts.
import { SOFTWARE_HERO } from "../config/software";
import { RESERVE_HREF } from "../config/reserve";
---

<section
  data-software-hero
  class="relative flex min-h-[600px] items-center justify-center overflow-hidden bg-[#050605] px-gutter-sm pt-header text-center text-white md:h-[calc(756*var(--fx))] md:min-h-0 md:px-gutter md:pt-0"
>
  <img
    src="/assets/images/software/hero-bg.jpg"
    width="1920"
    height="1080"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    class="pointer-events-none absolute inset-0 size-full object-cover"
  />
  <canvas data-ref="ambient" aria-hidden="true" class="pointer-events-none absolute inset-0 size-full"></canvas>
  <!-- Fade to paper (#fafaf7), 160 tall -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[120px] bg-linear-to-b from-[#fafaf7]/0 to-[#fafaf7] md:h-[calc(160*var(--fx))]"
  >
  </div>

  <!-- Copy block: title top at 171, body at 331, buttons at 480 on the 1920 frame -->
  <div class="relative flex flex-col items-center pb-16 md:pb-[calc(61*var(--fx))]">
    <h1
      class="text-hero-sm font-medium tracking-[-0.035em] md:text-[calc(128*var(--fx))] md:leading-[calc(121.6*var(--fx))] md:whitespace-nowrap"
    >
      {SOFTWARE_HERO.title}<span class="period">.</span>
    </h1>
    <p
      class="mt-5 max-w-[360px] text-[18px]/[26px] text-white/68 md:mt-[calc(38.4*var(--fx))] md:max-w-none md:whitespace-pre-line md:text-[calc(24*var(--fx))]/[calc(33.6*var(--fx))]"
    >
      {SOFTWARE_HERO.text}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3 md:mt-[calc(48.3*var(--fx))] md:gap-[calc(12*var(--fx))]">
      <a href={RESERVE_HREF} class="hero-btn bg-white text-black">Get early access →</a>
      <a href="#features" class="hero-btn hero-btn-ghost text-white">See what it does</a>
    </div>
  </div>
</section>

<script>
  import { AmbientField } from "../scripts/AmbientField";
  const canvas = document.querySelector<HTMLCanvasElement>("[data-software-hero] [data-ref=ambient]");
  // Pale blue glyphs on the dark backdrop (prototype `heroAmb`)
  if (canvas) new AmbientField(canvas, { color: "#dbe9ff", maxAlpha: 0.34, baseAlpha: 0.12, stepAlpha: 0.08 });
</script>

<style>
  /* Pill CTA (Figma: .btn.cream / .btn.ghost): 44 tall, 23 side padding, 16 semibold */
  .hero-btn {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding-inline: 23px;
    border-radius: 999px;
    font-size: 16px;
    line-height: 20px;
    font-weight: 600;
    transition: opacity 0.2s;
  }
  .hero-btn:hover {
    opacity: 0.88;
  }
  .hero-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .hero-btn-ghost {
    border: 1px solid rgb(255 255 255 / 22%);
    background: rgb(255 255 255 / 10%);
    backdrop-filter: blur(20px);
  }
  @media (width >= 768px) {
    .hero-btn {
      height: calc(44 * var(--fx));
      padding-inline: calc(23 * var(--fx));
      font-size: calc(16 * var(--fx));
      line-height: calc(20 * var(--fx));
    }
  }
</style>
