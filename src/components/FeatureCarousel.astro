---
// Homepage "Made for your daily tasks" carousel (Figma 20_carousel_1, 1157:416, a 1920 × 1311 frame). Desktop sizes are
// Figma px via --fx, so the section scales with the viewport; mobile stacks image over caption in real px.
// Content: src/config/carousel.ts. Behaviour (autoplay, spring, drag, pager): src/scripts/FeatureCarousel.ts.
import { CAROUSEL_SLIDES, CAROUSEL_SLIDE_MS } from "../config/carousel";
---

<section
  data-feature-carousel
  data-slide-ms={CAROUSEL_SLIDE_MS}
  aria-roledescription="carousel"
  aria-label="Made for your daily tasks"
  tabindex="0"
  class="carousel relative overflow-hidden bg-black text-white outline-none"
>
  <!-- Soft blue glow along the top edge (Figma img 20_carousel_1_1) -->
  <img src="/assets/images/carousel/glow.webp" width="1920" height="792" alt="" aria-hidden="true" loading="lazy" class="glow" />

  <h2 class="heading relative">
    <span class="font-normal text-white/55">Made for</span><br />
    <span class="font-medium">your daily tasks</span><span class="dot" aria-hidden="true"></span>
  </h2>

  <div data-ref="track" class="track relative">
    {
      CAROUSEL_SLIDES.map((slide, i) => (
        <article
          data-ref="card"
          data-layout={slide.layout}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${CAROUSEL_SLIDES.length}: ${slide.lead.replace(/\.$/, "")}`}
          class="card"
        >
          <div class="media">
            <img src={slide.image} width={slide.width} height={slide.height} alt="" loading="lazy" draggable="false" />
            {slide.layout === "split" && <div class="fade" aria-hidden="true" />}
            {slide.panel && (
              <div class="panel" aria-hidden="true">
                <p class="panel-title">{slide.panel.title}</p>
                <p class="chip">
                  <i />
                  {slide.panel.chip}
                </p>
              </div>
            )}
          </div>
          <p class="caption">
            <span class="text-white">{slide.lead}</span> {slide.rest}
          </p>
        </article>
      ))
    }
  </div>

  <div class="pager relative">
    <div class="pills" role="group" aria-label="Choose slide">
      {
        CAROUSEL_SLIDES.map((_, i) => (
          <button type="button" data-ref="dot" class="pill" aria-label={`Go to slide ${i + 1}`}>
            <i />
          </button>
        ))
      }
    </div>
    <button type="button" data-ref="toggle" class="toggle" aria-label="Pause autoplay">
      <svg class="icon-pause" viewBox="0 0 14 16" fill="currentColor" aria-hidden="true">
        <rect x="1" y="1" width="4" height="14" rx="1"></rect><rect x="9" y="1" width="4" height="14" rx="1"></rect>
      </svg>
      <svg class="icon-play" viewBox="0 0 14 16" fill="currentColor" aria-hidden="true">
        <path d="M2 1.5v13a.8.8 0 0 0 1.2.7l10-6.5a.8.8 0 0 0 0-1.4L3.2.8A.8.8 0 0 0 2 1.5Z"></path>
      </svg>
    </button>
  </div>
</section>

<script>
  import { FeatureCarousel } from "../scripts/FeatureCarousel";
  const root = document.querySelector<HTMLElement>("[data-feature-carousel]");
  if (root) new FeatureCarousel(root, Number(root.dataset.slideMs));
</script>

<style>
  /* Mobile first (real px); from 768px every size is Figma px (--fx) on the 1920 × 1311 frame */
  .carousel {
    padding: 96px 0 64px;
  }
  .glow {
    position: absolute;
    top: calc(9 * var(--fx));
    left: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .heading {
    margin: 0 var(--spacing-gutter-sm);
    font-size: var(--text-h2-sm);
    line-height: var(--text-h2-sm--line-height);
    letter-spacing: -0.03em;
  }

  /* Cards stack in one grid cell; FeatureCarousel slides them by card width + column-gap */
  .track {
    display: grid;
    column-gap: 16px;
    margin: 32px var(--spacing-gutter-sm) 0;
    touch-action: pan-y;
    user-select: none;
  }
  .carousel[data-dragging] .card {
    cursor: grabbing;
  }
  .card {
    grid-area: 1 / 1;
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 24px;
    background: var(--color-black);
    cursor: pointer;
    will-change: transform, opacity;
  }
  .media {
    position: relative;
    aspect-ratio: 774 / 744;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .card[data-layout="full"] .media img {
    object-position: 70% 50%;
  }
  .fade,
  .panel {
    display: none;
  }
  .caption {
    padding: 24px;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgb(255 255 255 / 0.5);
  }

  .pager {
    display: flex;
    justify-content: center;
    gap: calc(15 * var(--fx));
    margin-top: calc(53 * var(--fx));
  }
  .pills {
    display: flex;
    align-items: center;
    gap: calc(20.5 * var(--fx));
    height: calc(67 * var(--fx));
    padding: 0 calc(31.6 * var(--fx));
    border-radius: 999px;
    background: #1d1d1f;
  }
  /* Pager dot; the active one stretches into a pill that fills (<i>) with autoplay progress */
  .pill {
    position: relative;
    width: calc(13 * var(--fx));
    height: calc(13 * var(--fx));
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.4);
    cursor: pointer;
    transition:
      width 0.4s ease,
      background-color 0.3s;
  }
  .pill[data-active="true"] {
    width: calc(70.8 * var(--fx));
    background: rgb(255 255 255 / 0.3);
  }
  .pill i {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-white);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .toggle {
    display: grid;
    place-items: center;
    width: calc(67 * var(--fx));
    height: calc(67 * var(--fx));
    border-radius: 50%;
    background: #1d1d1f;
    color: var(--color-white);
    cursor: pointer;
  }
  .toggle:hover {
    background: #2c2c2e;
  }
  .toggle svg {
    width: calc(18.6 * var(--fx));
    height: calc(20.5 * var(--fx));
  }
  .icon-play,
  .toggle[data-paused="true"] .icon-pause {
    display: none;
  }
  .toggle[data-paused="true"] .icon-play {
    display: block;
  }
  .carousel:focus-visible .card,
  .pill:focus-visible,
  .toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (width >= 768px) {
    .carousel {
      padding: calc(146 * var(--fx)) 0 calc(111 * var(--fx));
    }
    .heading {
      margin: 0 0 0 calc(136 * var(--fx));
      font-size: calc(80 * var(--fx));
      line-height: calc(88 * var(--fx));
    }
    .track {
      width: calc(1500 * var(--fx));
      margin: calc(14 * var(--fx)) 0 0 calc(261 * var(--fx));
      column-gap: calc(24 * var(--fx));
    }
    .card {
      display: flex;
      align-items: center;
      height: calc(744 * var(--fx));
      border-radius: calc(32 * var(--fx));
    }
    /* Split cards: image on the right 774px, its left edge fading into the black card */
    .media {
      position: absolute;
      inset: 0 0 0 auto;
      width: calc(774 * var(--fx));
      aspect-ratio: auto;
    }
    .card[data-layout="full"] .media {
      width: 100%;
    }
    .card[data-layout="full"] .media img {
      object-position: 50% 50%;
    }
    .fade {
      display: block;
      position: absolute;
      inset: 0 auto 0 0;
      width: calc(124 * var(--fx));
      background: linear-gradient(90deg, var(--color-black), transparent);
    }
    .caption {
      position: relative;
      width: calc(560 * var(--fx));
      margin-left: calc(79 * var(--fx));
      padding: 0;
      font-size: calc(40 * var(--fx));
      line-height: calc(48 * var(--fx));
    }
    /* Full cards: caption sits top-left over the image */
    .card[data-layout="full"] {
      align-items: flex-start;
    }
    .card[data-layout="full"] .caption {
      width: calc(500 * var(--fx));
      margin: calc(55 * var(--fx)) 0 0 calc(63 * var(--fx));
      font-size: calc(36 * var(--fx));
      line-height: calc(44 * var(--fx));
    }
    /* Glass panel over card 2's image (Figma "3D Open World panel") */
    .panel {
      display: block;
      position: absolute;
      left: calc(44 * var(--fx));
      top: calc(434 * var(--fx));
      width: calc(385 * var(--fx));
      height: calc(117 * var(--fx));
      border: 1px solid rgb(255 255 255 / 0.14);
      border-radius: calc(27 * var(--fx));
      background: rgb(0 0 0 / 0.45);
    }
    .panel-title {
      position: absolute;
      left: calc(25 * var(--fx));
      top: calc(23 * var(--fx));
      font-size: calc(22 * var(--fx));
      font-weight: 600;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }
    .chip {
      position: absolute;
      left: calc(25 * var(--fx));
      top: calc(61 * var(--fx));
      display: flex;
      align-items: center;
      gap: calc(9 * var(--fx));
      width: calc(320 * var(--fx));
      height: calc(27 * var(--fx));
      padding-left: calc(11 * var(--fx));
      border: 1px solid rgb(255 255 255 / 0.28);
      border-radius: calc(14 * var(--fx));
      background: rgb(0 0 0 / 0.4);
      font-family: var(--font-mono);
      font-size: calc(13 * var(--fx));
      white-space: nowrap;
    }
    .chip i {
      flex: none;
      width: calc(9 * var(--fx));
      height: calc(9 * var(--fx));
      border-radius: 50%;
      background: var(--color-accent);
    }
  }
</style>
