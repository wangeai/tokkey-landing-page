---
// "Personal intelligence" section (Figma: Why Local AI / Scene 02 · Personal by nature): a workspace photo beside a
// headline and a diagram of the user's context flowing into the local model on their Mac. Sits below the statement.
// Sizes are Figma px via --fx (src/styles/global.css). Photo and text sit side by side from 1200px, stacked below.
// Reveal animation: src/scripts/scenes/PersonalScene.ts. Content: src/config/personal.ts.
import { CONTEXT_ITEMS } from "../config/personal";
---

<section
  id="personal"
  data-personal
  class="relative overflow-hidden bg-black px-gutter-sm py-20 text-white md:px-[calc(96*var(--fx))] md:pt-[calc(128*var(--fx))] md:pb-[calc(80*var(--fx))]"
>
  <div class="mx-auto grid max-w-[calc(1728*var(--fx))] gap-y-12 md:gap-y-[calc(64*var(--fx))] lg:grid-cols-[928fr_704fr] lg:gap-x-[calc(96*var(--fx))]">
    <!-- Workspace photo with its caption -->
    <figure data-reveal>
      <img
        src="/assets/images/privacy/workspace.webp"
        alt="Working on a MacBook at a wooden desk"
        width="2400"
        height="1600"
        loading="lazy"
        class="aspect-[928/824] w-full rounded-[calc(24*var(--fx))] object-cover"
      />
      <figcaption class="mt-4 text-body text-ash md:mt-[calc(24*var(--fx))] md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">
        Your projects. Your notes. Your next idea.
      </figcaption>
    </figure>

    <div class="lg:max-w-[calc(704*var(--fx))]">
      <p data-reveal class="label text-ash md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">02 / Personal intelligence</p>
      <h2 data-reveal class="mt-6 text-h2-sm font-bold md:mt-[calc(24*var(--fx))] md:text-[calc(64*var(--fx))]/[calc(72*var(--fx))]">
        <span class="text-chrome block">Personal intelligence.<br />Personal privacy<span class="period">.</span></span>
      </h2>
      <p data-reveal class="mt-8 text-lead text-ash md:mt-[calc(32*var(--fx))] md:text-[calc(24*var(--fx))]/[calc(32*var(--fx))]">
        The better AI knows your projects, files and<br class="max-lg:hidden" /> preferences, the more personal its context<br
          class="max-lg:hidden"
        /> becomes. Keep that work close.
      </p>

      <!-- Diagram: the context the user picks flows into the local model (Figma: Local processing / inside your Mac) -->
      <div data-reveal class="local-box mt-12 md:mt-[calc(64*var(--fx))]">
        <p class="label text-ash md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">On your Mac</p>
        <img src="/assets/icons/privacy/indicator.svg" width="8" height="8" alt="" aria-hidden="true" class="indicator" />

        <div class="mt-6 flex flex-col gap-4 md:mt-[calc(24*var(--fx))] md:flex-row md:items-start md:gap-0">
          <ul class="flex flex-col gap-4 md:w-[calc(248*var(--fx))] md:gap-[calc(16*var(--fx))]">
            {
              CONTEXT_ITEMS.map((item) => (
                <li class="context-item">
                  <img src="/assets/icons/privacy/file.svg" width="24" height="24" alt="" aria-hidden="true" class="size-[calc(24*var(--fx))]" />
                  {item}
                </li>
              ))
            }
          </ul>
          <!-- Curves joining each item to the model; only drawn where the items and the model sit side by side -->
          <img
            src="/assets/icons/privacy/context-lines.svg"
            width="136"
            height="136"
            alt=""
            aria-hidden="true"
            class="mt-[calc(24*var(--fx))] size-[calc(136*var(--fx))] max-md:hidden"
          />
          <div class="model-card">
            <b class="block text-[calc(24*var(--fx))]/[calc(32*var(--fx))] font-semibold text-fog">Local model</b>
            <span class="mt-[calc(8*var(--fx))] block text-[calc(16*var(--fx))]/[calc(24*var(--fx))] text-ash">Processes on your Mac</span>
          </div>
        </div>

        <p class="mt-4 text-body text-ash md:mt-[calc(16*var(--fx))] md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">
          The context you choose to share.
        </p>
      </div>

      <p data-reveal class="mt-8 text-lead text-fog md:mt-[calc(32*var(--fx))] md:text-[calc(24*var(--fx))]/[calc(32*var(--fx))]">
        Your context. Processed on your Mac.
      </p>
      <p data-reveal class="mt-10 text-body text-[#8e8e93] md:mt-[calc(40*var(--fx))] md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">
        Shown: local inference. Other connected tools may<br class="max-lg:hidden" /> use network services under their own policies.
      </p>
    </div>
  </div>
</section>

<script>
  import { PersonalScene } from "../scripts/scenes/PersonalScene";
  const section = document.querySelector<HTMLElement>("[data-personal]");
  if (section) new PersonalScene(section);
</script>

<style>
  /* Glass box around the diagram (same glass gradient as the comment cards) */
  .local-box {
    position: relative;
    padding: calc(23 * var(--fx)) calc(31 * var(--fx)) calc(15 * var(--fx));
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: calc(24 * var(--fx));
    background: linear-gradient(162.05deg, rgb(255 255 255 / 13%) 0%, rgb(255 255 255 / 4%) 71.429%);
  }
  /* Green "processing locally" dot, top right */
  .indicator {
    position: absolute;
    top: calc(31 * var(--fx));
    right: calc(55 * var(--fx));
    width: calc(8 * var(--fx));
    height: calc(8 * var(--fx));
  }

  /* Context item (Figma: Tokkey / Privacy / Context item) */
  .context-item {
    display: flex;
    align-items: center;
    gap: calc(16 * var(--fx));
    height: calc(48 * var(--fx));
    padding-inline: calc(16 * var(--fx));
    border-radius: calc(16 * var(--fx));
    background: rgb(255 255 255 / 5%);
    color: var(--color-fog);
    font-size: calc(16 * var(--fx));
    line-height: calc(24 * var(--fx));
  }

  /* Local model card: darker, opaque glass like the featured comment card */
  .model-card {
    padding: calc(23 * var(--fx));
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: calc(24 * var(--fx));
    background: linear-gradient(159.44deg, rgb(70 70 82 / 92%) 0%, rgb(24 24 30 / 94%) 71.429%);
  }
  @media (width >= 768px) {
    .model-card {
      width: calc(256 * var(--fx));
      height: calc(128 * var(--fx));
      margin-top: calc(40 * var(--fx));
    }
  }
</style>
