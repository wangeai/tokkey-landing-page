---
// Tokkey app UI shown on the laptop screen at the end of scene "pullBack" (ported from legacy #lid3).
// Laid out 1000px wide (height set to the display's aspect ratio) and scaled onto the screen by HeroScene; [data-screen-item] elements reveal one by one.
---

<div data-ref="screen" class="screen absolute top-0 left-0 h-[640px] w-[1000px] origin-top-left opacity-0">
  <div class="menubar">
    <b>Tokkey</b><span>File</span><span>Edit</span><span>View</span><span>Window</span><span class="ml-auto">Wed 9:41</span>
  </div>

  <!-- Local models panel -->
  <div data-screen-item class="card models">
    <div class="card-head">
      <div><h3>Local Models</h3><p>Download, start, and manage models stored on this Mac.</p></div>
      <span class="pill">Tokkey hardware</span>
    </div>
    <div class="model"><i class="check"></i><div><b>Qwen3.6 35B-A3B</b><small>Recommended · 23 GB · Qwen</small></div><span class="pill">Start</span></div>
    <div class="model running"><i class="check on"></i><div><b>Qwen3.5 4B</b><small>2.8 GB · Alibaba Qwen</small></div><span class="status"><u></u>Running</span></div>
    <div class="model"><i class="check"></i><div><b>Qwen3.5 9B</b><small>5.7 GB · Qwen</small></div><span class="pill">Start</span></div>
  </div>

  <!-- Private chat panel -->
  <div data-screen-item class="card chat">
    <i class="check big"></i>
    <h3>Private Chat</h3>
    <p>A local agent for your Mac.</p>
    <div class="bullets"><span><u></u>Uses Tokkey’s local model.</span><span><u></u>Tool network access is off.</span></div>
    <div class="input">
      <span>Message your local agent… Paste images or files here.</span>
      <div class="input-row"><span class="pill">Ask</span><span class="model-pick"><u></u>Qwen3.5 4B · Local</span><i class="send"></i></div>
    </div>
  </div>

  <!-- Router panel -->
  <div data-screen-item class="card router">
    <div class="card-head">
      <div><h3>Router</h3><p>Simple tasks run on your Tokkey. Hard ones go to a cloud model.</p></div>
      <i class="toggle"></i>
    </div>
    <div class="routes">
      <div><em>LOCAL MODEL</em><p>Current running model on this Mac</p><div class="route"><i class="check on"></i><b>Qwen3.5 4B<small>On this Mac</small></b></div></div>
      <div><em>CLOUD MODEL</em><p>Used only for complex tasks</p><div class="route"><i class="check"></i><b>Cloud model<small>You choose which</small></b></div></div>
    </div>
  </div>

  <!-- Floating status pills -->
  <div data-screen-item class="float" style="left:70px;top:296px"><u></u>Nothing leaves this Mac<em>0 B sent</em></div>
  <div data-screen-item class="float" style="left:628px;top:336px"><u class="local"></u>Private task → Local<em>on-device</em></div>
  <div data-screen-item class="float" style="left:700px;top:390px"><u class="cloud"></u>Hard task → Cloud<em>you choose</em></div>

  <!-- Running tasks bar; HeroScene animates the CPU / Memory / GPU readings -->
  <div data-screen-item class="tasks">
    <div class="task">
      <i class="icon"></i>
      <div class="task-text"><b><span class="accent">Local agent:</span> Audit overdue invoices</b><span class="chip">Local orchestrator</span><span class="muted">Fetching fees</span></div>
      <div class="meters">
        <span>CPU <svg viewBox="0 0 40 10"><path d="M0 7 C6 3 9 8 15 5 S27 2 40 6" fill="none" stroke="#7fd6c6" stroke-width="1.4"></path></svg><em data-ref="cpu">19%</em></span>
        <span>Memory <em data-ref="mem">81%</em></span>
        <span>GPU <svg viewBox="0 0 40 10"><path d="M0 6 C8 8 12 2 20 5 S32 8 40 3" fill="none" stroke="#9a8cff" stroke-width="1.4"></path></svg><em data-ref="gpu">60%</em></span>
      </div>
      <i class="stop"></i><i class="chevron"></i>
    </div>
    <div class="task">
      <i class="icon"></i>
      <div class="task-text"><b>PR triage</b><span class="chip">Claude Sonnet 5</span><span class="muted">Tagging owners</span></div>
      <i class="stop"></i><i class="chevron"></i>
    </div>
    <div class="task-count"><i class="icon"></i>2 tasks running</div>
  </div>
</div>

<style>
