---
// Live 3D key over the frame stage's last scene: fades in after scene 007 (effect "productViewer"), drag to orbit,
// with the standalone viewer's controls (Auto Rotate, Explode, Reset view). Goes in FrameStage's slot.
// Behavior: src/scripts/scenes/ProductViewerScene.ts.
---

<!-- Same area as the frame canvas (below the nav), so the model never hides behind it -->
<!-- Two-step crossfade: the black layer fades in over the last frame, then the content fades in on the black -->
<div data-product-viewer class="viewer absolute inset-x-0 top-header bottom-0" inert>
  <div data-ref="content" class="content absolute inset-0">
    <canvas data-ref="canvas" class="canvas absolute inset-x-0 top-0 h-full w-full" aria-label="3D model of the Tokkey key, drag to rotate"></canvas>
    <div class="controls">
      <p data-ref="hint" class="hint font-mono">Drag to rotate</p>
      <div class="panel" role="toolbar" aria-label="3D model controls">
        <button data-ref="spin" class="chip" type="button" aria-pressed="true">Auto Rotate</button>
        <button data-ref="explode" class="chip" type="button" aria-pressed="false" disabled>Explode</button>
        <span class="sep" aria-hidden="true"></span>
        <button data-ref="reset" class="icon" type="button" aria-label="Reset view" title="Reset view">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { ProductViewerScene } from "../scripts/scenes/ProductViewerScene";
  const root = document.querySelector<HTMLElement>("[data-product-viewer]");
  const section = root?.closest<HTMLElement>("[data-frame-stage]");
  if (root && section) new ProductViewerScene(root, section);
</script>

<style>
  .viewer {
    opacity: 0;
    background: var(--color-black);
    pointer-events: none;
  }
  .content {
    opacity: 0;
  }
  .viewer.is-live {
    pointer-events: auto;
    cursor: grab;
  }
  .viewer.is-live:active {
    cursor: grabbing;
  }

  .controls {
    position: absolute;
    inset-inline: 0;
    bottom: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-inline: 16px;
    pointer-events: none;
  }

  .hint {
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ash);
    transition: opacity 0.5s;
  }
  .hint:global(.is-gone) {
    opacity: 0;
  }

  /* Glass pill holding the controls (brand chip colors, docs/tokkey-brand-web/SKILL.md) */
  .panel {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 28px;
    border: 1px solid rgb(242 242 242 / 24%);
    background: rgb(0 0 0 / 56%);
    backdrop-filter: blur(20px) saturate(180%);
    pointer-events: auto;
  }
  .chip {
    height: 36px;
    padding: 0 16px;
    border-radius: 18px;
    color: var(--color-ash);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .chip:hover {
    color: var(--color-fog);
  }
  .chip[aria-pressed="true"] {
    background: var(--color-fog);
    color: var(--color-black);
  }
  .chip:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .sep {
    width: 1px;
    height: 20px;
    margin: 0 4px;
    background: rgb(242 242 242 / 16%);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--color-ash);
    cursor: pointer;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .icon:hover {
    color: var(--color-fog);
    background: rgb(255 255 255 / 8%);
  }
  .panel button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Phones: keep clear of the Kickstarter button in the bottom-right corner, and end the model above the controls
     so the exploded parts don't run behind them */
  @media (max-width: 767px) {
    .controls {
      bottom: 104px;
    }
    .canvas {
      height: calc(100% - 200px);
    }
    .chip {
      padding: 0 12px;
    }
  }
</style>
