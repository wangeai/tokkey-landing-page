---
// Live 3D key over the frame stage's last scene: fades in after scene 007 (effect "productViewer"), drag to orbit,
// Explode / Reset below. Goes in FrameStage's slot. Behavior: src/scripts/scenes/ProductViewerScene.ts.
---

<!-- Full height, under the nav (unlike the frame canvas), so the model frames as large as the standalone viewer -->
<div data-product-viewer class="viewer absolute inset-0 bg-black" inert>
  <canvas data-ref="canvas" class="canvas absolute inset-x-0 top-0 h-full w-full" aria-label="3D model of the Tokkey key, drag to rotate"></canvas>
  <div class="controls">
    <p data-ref="hint" class="hint font-mono">Drag to rotate</p>
    <div class="buttons">
      <button data-ref="explode" class="chip" type="button" aria-pressed="false" disabled>Explode</button>
      <button data-ref="reset" class="chip icon" type="button" aria-label="Reset view">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 3-6.7"></path><path d="M3 4v5h5"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  import { ProductViewerScene } from "../scripts/scenes/ProductViewerScene";
  const root = document.querySelector<HTMLElement>("[data-product-viewer]");
  const section = root?.closest<HTMLElement>("[data-frame-stage]");
  if (root && section) new ProductViewerScene(root, section);
</script>

<style>
  .viewer {
    opacity: 0;
    /* Smooths the late fade-in when the model finishes loading after the user already scrolled here */
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .viewer.is-live {
    pointer-events: auto;
    cursor: grab;
  }
  .viewer.is-live:active {
    cursor: grabbing;
  }

  .controls {
    position: absolute;
    inset-inline: 0;
    bottom: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    pointer-events: none;
  }
  .buttons {
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }

  .hint {
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ash);
    transition: opacity 0.5s;
  }
  .hint:global(.is-gone) {
    opacity: 0;
  }

  /* Brand chip (docs/tokkey-brand-web/SKILL.md) */
  .chip {
    height: 48px;
    padding: 0 24px;
    border-radius: 24px;
    border: 1px solid rgb(242 242 242 / 24%);
    background: rgb(0 0 0 / 56%);
    color: var(--color-fog);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .chip:hover {
    opacity: 0.88;
  }
  .chip:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .chip.icon {
    display: grid;
    place-items: center;
    width: 48px;
    padding: 0;
  }

  /* Phones: keep clear of the Kickstarter button in the bottom-right corner, and end the model above the controls
     so the exploded parts don't run behind them */
  @media (max-width: 767px) {
    .controls {
      bottom: 104px;
    }
    .canvas {
      height: calc(100% - 200px);
    }
  }
</style>
