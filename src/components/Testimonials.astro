---
// Homepage "Real people. Local AI." quotes (Figma 24_carousel_5, 1161:192): centred heading and subtitle over a soft
// blue glow, six quote cards in a 3-column grid (2 columns on tablet, 1 on mobile). Desktop sizes are Figma px via
// --fx. Heading, subtitle and cards fade up in sequence (ScrollReveal). Content: src/config/testimonials.ts.
import { TESTIMONIALS } from "../config/testimonials";
---

<section data-testimonials class="testimonials relative overflow-hidden bg-black text-white">
  <!-- Blue glow behind the grid (Figma img 24_carousel_5_3) -->
  <img src="/assets/images/testimonials/glow.webp" width="1200" height="640" alt="" aria-hidden="true" loading="lazy" class="glow" />

  <h2 data-reveal class="heading relative text-center font-medium">
    <span class="text-white/55">Real people.</span> <span class="whitespace-nowrap">Local AI<span class="dot" aria-hidden="true"></span></span>
  </h2>
  <p data-reveal class="subtitle relative text-center text-white/60">A little key. A different way to work.</p>

  <ul class="grid relative" role="list">
    {
      TESTIMONIALS.map((t) => (
        <li data-reveal class="card">
          <figure class="contents">
            <figcaption class="profile">
              <span class="avatar" aria-hidden="true">{t.initials}</span>
              <span class="flex flex-col">
                <span class="role">{t.role}</span>
                <span class="text-[#a1a1a6]">Example profile</span>
              </span>
            </figcaption>
            <blockquote class="quote">
              {t.lines.map((line, i) => (
                <>
                  {i > 0 && <br class="max-md:hidden" />}
                  {i > 0 && " "}
                  {line}
                </>
              ))}
            </blockquote>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { ScrollReveal } from "../scripts/ScrollReveal";
  const section = document.querySelector<HTMLElement>("[data-testimonials]");
  if (section) ScrollReveal.section(section);
</script>

<style>
  /* Mobile first (real px); from 768px every size is Figma px (--fx) on the 1920-wide frame */
  .testimonials {
    padding: 64px var(--spacing-gutter-sm);
  }
  .glow {
    position: absolute;
    left: 50%;
    top: calc(294 * var(--fx));
    width: calc(1200 * var(--fx));
    max-width: none;
    height: auto;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .heading {
    font-size: var(--text-h2-sm);
    line-height: var(--text-h2-sm--line-height);
    letter-spacing: -0.03em;
  }
  .subtitle {
    margin-top: 16px;
    font-size: 18px;
    line-height: 28px;
  }
  .grid {
    display: grid;
    gap: 16px;
    margin: 40px auto 0;
  }
  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 24px;
    border-radius: 16px;
    background: #1a1a1a;
    transition: background-color 0.3s;
  }
  .card:hover {
    background: #2e2e2e;
  }
  .profile {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 16px;
    line-height: 24px;
  }
  /* Initials tile (Figma avatar images: soft white gradient, hairline border) */
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 16px;
    background: linear-gradient(143deg, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0.07) 71%);
    font-weight: 500;
    color: #e5e5ea;
  }
  .role {
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .quote {
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #f5f5f7;
  }

  @media (width >= 768px) {
    .testimonials {
      padding: calc(94 * var(--fx)) 0 calc(92 * var(--fx));
    }
    .heading {
      font-size: calc(80 * var(--fx));
      line-height: calc(88 * var(--fx));
    }
    .subtitle {
      margin-top: calc(24 * var(--fx));
      font-size: calc(24 * var(--fx));
      line-height: calc(32 * var(--fx));
    }
    .grid {
      grid-template-columns: repeat(2, calc(448 * var(--fx)));
      grid-auto-rows: calc(248 * var(--fx));
      gap: calc(24 * var(--fx));
      justify-content: center;
      margin-top: calc(88.5 * var(--fx));
    }
    .card {
      gap: 0;
      padding: calc(32 * var(--fx));
    }
    .profile {
      gap: calc(16 * var(--fx));
      font-size: calc(16 * var(--fx));
      line-height: calc(24 * var(--fx));
    }
    .avatar {
      width: calc(48 * var(--fx));
      height: calc(48 * var(--fx));
      border-radius: calc(16 * var(--fx));
    }
    /* Hold the designed lines: Inter runs a little wider than Figma's Geist, so a line may reach into the padding */
    .quote {
      font-size: calc(32 * var(--fx));
      white-space: nowrap;
    }
  }
  /* Three columns once the 1392px grid fits (at 1200px --fx is 0.625) */
  @media (width >= 1200px) {
    .grid {
      grid-template-columns: repeat(3, calc(448 * var(--fx)));
    }
  }
</style>
