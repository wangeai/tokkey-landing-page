---
// Floating "Sign up for Kickstarter" button, bottom-right on every page (prototype `#kkw`, glass style): opens an email
// card; the Kickstarter sticker pops in beside the button for a while. Behavior: src/scripts/KickstarterWidget.ts.
---

<div data-kickstarter class="kk">
  <img class="sticker" src="/assets/images/kickstarter/sticker.png" width="172" height="179" alt="" aria-hidden="true" />
  <button data-ref="toggle" class="toggle" type="button" aria-expanded="false" aria-controls="kickstarter-card">
    <img src="/assets/images/kickstarter/icon.png" width="21" height="24" alt="" />
    Sign up for Kickstarter
  </button>

  <div data-ref="card" id="kickstarter-card" class="card" role="dialog" aria-labelledby="kickstarter-title" inert>
    <button data-ref="close" class="close" type="button" aria-label="Close">×</button>
    <div class="intro">
      <h2 id="kickstarter-title">Sign up for Kickstarter</h2>
      <p>Leave your email and we’ll tell you when Tokkey is ready.</p>
    </div>
    <form data-ref="form" novalidate>
      <input data-ref="email" type="email" placeholder="you@email.com" autocomplete="email" aria-label="Email" />
      <p data-ref="error" class="error" role="alert"></p>
      <button type="submit">Notify me</button>
    </form>
    <div class="done" role="status">
      <strong><i></i>You’re on the list.</strong>
      <p>We’ll email you as soon as Tokkey is ready.</p>
    </div>
  </div>
</div>

<script>
  import { KickstarterWidget } from "../scripts/KickstarterWidget";
  const root = document.querySelector<HTMLElement>("[data-kickstarter]");
  if (root) new KickstarterWidget(root);
</script>

<style>
  .kk {
    position: fixed;
    right: max(24px, env(safe-area-inset-right, 0px));
    bottom: max(24px, env(safe-area-inset-bottom, 0px));
    z-index: 60;
  }

  /* Glass pill: 56 tall, translucent grey with a strong backdrop blur */
  .toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 24px;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 28px;
    background: rgb(120 120 128 / 32%);
    backdrop-filter: blur(24px) saturate(180%);
    box-shadow:
      0 8px 32px rgb(0 0 0 / 35%),
      inset 0 1px 0 rgb(255 255 255 / 18%);
    color: #fff;
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    cursor: pointer;
    transition:
      opacity 0.25s,
      transform 0.25s,
      padding 0.5s;
  }
  .toggle:hover {
    opacity: 0.9;
  }
  .toggle img {
    height: 24px;
    width: auto;
  }
  .kk :is(button, input):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Sticker overlaps the button's left end; the button makes room while it shows */
  .sticker {
    position: absolute;
    z-index: 2;
    left: -64px;
    bottom: -10px;
    width: 112px;
    height: auto;
    pointer-events: none;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 50%));
    opacity: 0;
    transform: rotate(-12deg) scale(0.4);
    transform-origin: 50% 60%;
    transition:
      opacity 0.3s,
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .kk.is-pop:not(.is-open) .sticker {
    opacity: 1;
    transform: rotate(-10deg) scale(1);
  }
  .kk.is-pop .toggle {
    padding-left: 56px;
  }

  /* Email card: anchored to the button's corner, replaces it while open */
  .card {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 360px;
    max-width: calc(100vw - 32px);
    padding: 24px;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 24px;
    background: rgb(40 40 44 / 55%);
    backdrop-filter: blur(28px) saturate(180%);
    box-shadow:
      0 16px 48px rgb(0 0 0 / 45%),
      inset 0 1px 0 rgb(255 255 255 / 14%);
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    pointer-events: none;
    transition:
      opacity 0.25s,
      transform 0.25s;
  }
  .kk.is-open .card {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .kk.is-open .toggle {
    opacity: 0;
    transform: scale(0.9);
    pointer-events: none;
  }
  .card h2,
  .done strong {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #f2f2f2;
  }
  .card p {
    margin: 8px 0 16px;
    font-size: 16px;
    line-height: 24px;
    color: #a1a1a6;
  }
  .close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    color: #a1a1a6;
    font-size: 20px;
    line-height: 32px;
    cursor: pointer;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  input,
  form button {
    height: 48px;
    border-radius: 16px;
    font-size: 16px;
    line-height: 24px;
  }
  input {
    padding: 0 16px;
    border: 1px solid rgb(255 255 255 / 20%);
    background: rgb(0 0 0 / 28%);
    color: #f2f2f2;
  }
  form button {
    background: rgb(255 255 255 / 92%);
    color: #000;
    font-weight: 600;
    cursor: pointer;
  }
  .card .error {
    min-height: 20px;
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: #f83830;
  }

  /* Success state swaps the intro and form for the confirmation */
  .done {
    display: none;
  }
  .card.is-done :is(.intro, form) {
    display: none;
  }
  .card.is-done .done {
    display: block;
  }
  .done i {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .kk * {
      transition: none !important;
    }
  }
</style>
