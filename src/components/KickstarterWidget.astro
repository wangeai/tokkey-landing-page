---
// Floating "Sign up for Kickstarter" link, bottom-right on every page (prototype `#kkw`, glass style): opens the shop
// (shop.tokkey.ai) in a new tab; the Kickstarter sticker pops in beside the button for a while. Behavior: src/scripts/KickstarterWidget.ts.

/** Shop page both the pill and the sticker open in a new tab */
const SHOP_URL = "https://n1wgyk-eh.myshopify.com/products/tokkey-deposit-reservation";
---

<div data-kickstarter class="kk">
  <!-- Sticker is a second, mouse-only route to the shop; the pill below is the accessible link -->
  <a class="sticker" href={SHOP_URL} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
    <img src="/assets/images/kickstarter/sticker.png" width="172" height="179" alt="" />
  </a>
  <a class="toggle" href={SHOP_URL} target="_blank" rel="noopener">
    <img src="/assets/images/kickstarter/icon.png" width="21" height="24" alt="" />
    Sign up for Kickstarter
  </a>
</div>

<script>
  import { KickstarterWidget } from "../scripts/KickstarterWidget";
  const root = document.querySelector<HTMLElement>("[data-kickstarter]");
  if (root) new KickstarterWidget(root);
</script>

<style>
  .kk {
    position: fixed;
    right: max(24px, env(safe-area-inset-right, 0px));
    bottom: max(24px, env(safe-area-inset-bottom, 0px));
    z-index: 60;
  }

  /* Glass pill: 56 tall, translucent grey with a strong backdrop blur */
  .toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 24px;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 28px;
    background: rgb(120 120 128 / 32%);
    backdrop-filter: blur(24px) saturate(180%);
    box-shadow:
      0 8px 32px rgb(0 0 0 / 35%),
      inset 0 1px 0 rgb(255 255 255 / 18%);
    color: #fff;
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    cursor: pointer;
    transition:
      opacity 0.25s,
      transform 0.25s,
      padding 0.5s;
  }
  .toggle:hover {
    opacity: 0.9;
  }
  .toggle img {
    height: 24px;
    width: auto;
  }
  .toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Sticker overlaps the button's left end; the button makes room while it shows */
  .sticker {
    position: absolute;
    z-index: 2;
    left: -64px;
    bottom: -10px;
    width: 112px;
    height: auto;
    pointer-events: none;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 50%));
    opacity: 0;
    transform: rotate(-12deg) scale(0.4);
    transform-origin: 50% 60%;
    transition:
      opacity 0.3s,
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sticker img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Clickable only while it's visible */
  .kk.is-pop .sticker {
    pointer-events: auto;
    opacity: 1;
    transform: rotate(-10deg) scale(1);
  }
  .kk.is-pop .toggle {
    padding-left: 56px;
  }

  @media (prefers-reduced-motion: reduce) {
    .kk * {
      transition: none !important;
    }
  }
</style>
