---
// Hero frame stage: every frame sequence in src/config/timeline.ts plays as one scroll-driven strip on the canvas
// (src/scripts/scenes/FrameStageScene.ts); it pins while the page scrolls through it. Overlays for effect segments
// go in the slot, above the canvas.
---

<section class="relative h-svh overflow-hidden bg-black" data-frame-stage>
  <!-- Starts below the fixed nav so frames aren't hidden behind it -->
  <canvas data-ref="frames" class="absolute inset-x-0 top-header h-[calc(100%-var(--spacing-header))] w-full"></canvas>
  <slot />
</section>

<script>
  import { FrameStageScene } from "../scripts/scenes/FrameStageScene";
  const section = document.querySelector<HTMLElement>("[data-frame-stage]");
  if (section) new FrameStageScene(section);
</script>
