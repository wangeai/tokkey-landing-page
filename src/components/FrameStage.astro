---
// Hero frame stage: every frame sequence in src/config/timeline.ts plays as one scroll-driven strip, scrubbing one video
// per sequence inside [data-ref=frames] (src/scripts/scenes/FrameStageScene.ts); it pins while the page scrolls
// through it. Overlays for effect segments go in the slot, above the videos.
---

<section class="relative h-svh overflow-hidden bg-black" data-frame-stage>
  <div data-ref="frames" class="absolute inset-0"></div>
  <slot />
</section>

<script>
  import { FrameStageScene } from "../scripts/scenes/FrameStageScene";
  const section = document.querySelector<HTMLElement>("[data-frame-stage]");
  if (section) new FrameStageScene(section);
</script>
