---
// Software page "Early access" section (Figma: S6 Early access): a frosted panel over a static ASCII field, holding the
// five steps from request to running and the glass application form. Sizes are Figma px via --fx
// (src/styles/global.css); steps and form sit side by side from 1200px, stacked below. Content: src/config/software.ts.
import { EARLY_ACCESS_STEPS, MAC_CHIPS, MAC_MEMORY, MAC_MODELS } from "../config/software";
---

<section
  id="early"
  data-early-access
  class="relative overflow-hidden bg-black px-gutter-sm py-24 text-white md:p-[calc(120*var(--fx))]"
>
  <!-- Hero backdrop with a sweeping luminous ASCII ripple (src/scripts/RippleField.ts) -->
  <img
    src="/assets/images/software/hero-bg.jpg"
    width="1920"
    height="1080"
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="pointer-events-none absolute inset-0 size-full object-cover"
  />
  <canvas data-ref="ripple" aria-hidden="true" class="pointer-events-none absolute inset-0 size-full"></canvas>

  <div class="panel">
    <div>
      <p data-reveal class="label text-white/70 md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">Early access</p>
      <h2 data-reveal class="mt-2 text-h2-sm font-bold md:mt-[calc(8*var(--fx))] md:text-[calc(64*var(--fx))]/[calc(72*var(--fx))]">
        From request<br />to running<span class="period">.</span>
      </h2>

      <ol class="mt-8 flex flex-col gap-6 md:mt-[calc(28*var(--fx))] md:gap-[calc(24*var(--fx))]">
        {
          EARLY_ACCESS_STEPS.map((step, i) => (
            <li data-reveal class="flex gap-[calc(24*var(--fx))]" aria-current={i === 0 ? "step" : undefined}>
              <span class:list={["num", { current: i === 0 }]}>
                {i === 0 ? (
                  <img src="/assets/icons/software/step-active.svg" width="80" height="80" alt="" aria-hidden="true" class="step-ring step-glow" />
                ) : (
                  <img src="/assets/icons/software/step.svg" width="48" height="48" alt="" aria-hidden="true" class="step-ring" />
                )}
                <span class="relative">{String(i + 1).padStart(2, "0")}</span>
              </span>
              <span>
                <b class="step-title">{step.title}</b>
                <span class="step-text">{step.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Application form (Figma: fm, 640×800 glass card) -->
    <form data-reveal class="form" aria-labelledby="early-title">
      <h3 id="early-title" class="form-title">Get early access</h3>
      <p class="form-lead">Try on-device tasks on your Mac and share feedback. Selected users receive $20 in free Router credits.</p>

      <label class="field-label mt-[calc(32*var(--fx))]" for="early-email">Email</label>
      <input id="early-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required class="field" />

      <!-- "Your Mac": native selects so the OS draws the dropdown; the empty first option is the placeholder -->
      <fieldset class="mt-[calc(40*var(--fx))]">
        <legend class="section-title">Your Mac</legend>

        <label class="field-label mt-[calc(24*var(--fx))]" for="early-model">Mac model</label>
        <select id="early-model" name="model" required class="field select">
          <option value="">Select your Mac</option>
          {MAC_MODELS.map((model) => <option>{model}</option>)}
        </select>

        <div class="mt-[calc(24*var(--fx))] grid grid-cols-2 gap-[calc(24*var(--fx))]">
          <div class="flex min-w-0 flex-col">
            <label class="field-label" for="early-chip">Chip</label>
            <select id="early-chip" name="chip" required class="field select">
              <option value="">Select chip</option>
              {MAC_CHIPS.map((chip) => <option>{chip}</option>)}
            </select>
          </div>
          <div class="flex min-w-0 flex-col">
            <label class="field-label" for="early-memory">Memory</label>
            <select id="early-memory" name="memory" required class="field select">
              <option value="">Select memory</option>
              {MAC_MEMORY.map((memory) => <option>{memory}</option>)}
            </select>
          </div>
        </div>

        <p class="form-hint">
          Find these details in Apple menu
          <img src="/assets/icons/software/hint-apple.svg" width="14" height="14" alt="Apple" class="hint-apple" />
          → About This Mac.
        </p>
      </fieldset>

      <button type="submit" class="submit">Apply for access</button>
      <p class="form-note">We'll review your device details and email you if you're selected.</p>
    </form>
  </div>
</section>

<script>
  import { ScrollReveal } from "../scripts/ScrollReveal";
  const section = document.querySelector<HTMLElement>("[data-early-access]");
  import { RippleField } from "../scripts/RippleField";
  if (section) {
    ScrollReveal.section(section);
    new RippleField(section.querySelector<HTMLCanvasElement>("[data-ref=ripple]")!, {
      sweep: true,
      y: 0.62,
      textureWeight: 1,
      rippleWeight: 0.7,
      decay: 1100,
    });
  }
</script>

<style>
  /* Frosted panel (Figma: access panel, 1680×840): steps 96 in from the top-left, form 102 in from the right */
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 32px 20px;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: calc(24 * var(--fx));
    background: rgb(255 255 255 / 10%);
  }
  @media (width >= 768px) {
    .panel {
      padding: calc(95 * var(--fx));
    }
  }
  @media (width >= 1200px) {
    .panel {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      min-height: calc(840 * var(--fx));
      padding-right: calc(101 * var(--fx));
    }
  }

  /* Step number in a 48 circle; the current step's white circle carries a green glow (80 asset, 16 bleed) */
  .num {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: calc(48 * var(--fx));
    height: calc(48 * var(--fx));
    margin-top: calc(4 * var(--fx));
    color: rgb(255 255 255 / 90%);
    font-family: var(--font-mono);
    font-size: calc(16 * var(--fx));
    line-height: calc(24 * var(--fx));
    letter-spacing: 1.4px;
  }
  .num.current {
    color: #16191a;
  }
  .step-ring {
    position: absolute;
    max-width: none;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .step-glow {
    inset: calc(-16 * var(--fx));
    width: calc(80 * var(--fx));
    height: calc(80 * var(--fx));
  }
  .step-title {
    display: block;
    font-size: calc(24 * var(--fx));
    line-height: calc(32 * var(--fx));
    font-weight: 600;
    letter-spacing: -0.5px;
  }
  .step-text {
    display: block;
    color: rgb(255 255 255 / 65%);
    font-size: calc(16 * var(--fx));
    line-height: calc(24 * var(--fx));
  }

  /* Glass form card (Figma: 640×800, 48 padding, 56-tall fields and button) */
  .form {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    padding: 32px 20px;
    border: calc(1.181 * var(--fx)) solid rgb(255 255 255 / 50%);
    border-radius: calc(32 * var(--fx));
    /* Node fill is 40% → 20% white, but Figma renders the card at ~#d1d1d1 → #c5c5c5 on the panel; match the render */
    background: linear-gradient(144.18deg, rgb(255 255 255 / 80%) 13.4%, rgb(255 255 255 / 75%) 86.6%);
    backdrop-filter: blur(calc(17.721 * var(--fx)));
    box-shadow: 0 calc(1.181 * var(--fx)) 0 rgb(255 255 255 / 70%);
    color: #16191a;
  }
  @media (width >= 768px) {
    .form {
      width: calc(640 * var(--fx));
      min-height: calc(800 * var(--fx));
      padding: calc(48 * var(--fx));
    }
  }
  .form-title {
    font-size: calc(48 * var(--fx));
    line-height: calc(56 * var(--fx));
    font-weight: 700;
    letter-spacing: calc(-0.96 * var(--fx));
  }
  .form-lead {
    max-width: calc(420 * var(--fx));
    margin-top: calc(16 * var(--fx));
    color: #6b6f68;
    font-size: calc(16 * var(--fx));
    line-height: calc(24 * var(--fx));
  }
  .section-title {
    font-size: calc(24 * var(--fx));
    line-height: calc(32 * var(--fx));
    font-weight: 500;
  }
  .field-label {
    display: block;
    font-size: calc(16 * var(--fx));
    line-height: calc(24 * var(--fx));
    font-weight: 500;
  }
  .field {
    width: 100%;
    height: calc(56 * var(--fx));
    margin-top: calc(8 * var(--fx));
    padding-inline: calc(16 * var(--fx));
    border: 1px solid rgb(22 25 26 / 8%);
    border-radius: calc(16 * var(--fx));
    background: rgb(255 255 255 / 70%);
    color: #16191a;
    font-size: calc(16 * var(--fx));
    outline: none;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .field::placeholder {
    color: #6b6f68;
  }
  .field:focus-visible {
    border-color: var(--color-accent);
    background: rgb(255 255 255 / 85%);
  }
  /* Select: custom chevron 20 in from the right; the OS draws the open list. Empty (placeholder) value reads grey */
  .select {
    appearance: none;
    padding-right: calc(44 * var(--fx));
    background: rgb(255 255 255 / 70%) url("/assets/icons/software/select-chevron.svg") no-repeat right calc(20 * var(--fx)) center /
      calc(12 * var(--fx)) calc(8 * var(--fx));
    text-overflow: ellipsis;
    cursor: pointer;
  }
  .select:invalid {
    color: #6b6f68;
  }
  .select option {
    color: #16191a;
  }
  .form-hint {
    margin-top: calc(16 * var(--fx));
    color: #6b6f68;
    font-size: calc(14 * var(--fx));
    line-height: calc(24 * var(--fx));
  }
  .hint-apple {
    display: inline-block;
    width: calc(14 * var(--fx));
    height: calc(14 * var(--fx));
    margin-inline: calc(4 * var(--fx)) calc(2 * var(--fx));
    vertical-align: calc(-2 * var(--fx));
  }
  .submit {
    height: calc(56 * var(--fx));
    margin-top: calc(24 * var(--fx));
    border-radius: calc(16 * var(--fx));
    background: #111110;
    box-shadow: 0 calc(8 * var(--fx)) calc(24 * var(--fx)) rgb(10 20 10 / 30%);
    color: #fff;
    font-size: calc(16 * var(--fx));
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .submit:hover {
    opacity: 0.88;
  }
  .submit:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .form-note {
    margin-top: calc(24 * var(--fx));
    color: #6b6f68;
    font-size: calc(16 * var(--fx));
    line-height: calc(24 * var(--fx));
  }

  /* Mobile: Figma px would crowd a phone, so the form type steps down */
  @media (width < 768px) {
    .form-title {
      font-size: 32px;
      line-height: 40px;
      letter-spacing: -1px;
    }
    .form-lead {
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
