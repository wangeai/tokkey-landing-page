---
// Site footer (Figma: Footer · keyframe 1920 (social media)): wordmark, tagline and social links, three link columns,
// and a legal line, over a faint animated ASCII field. Sizes are Figma px via --fx (src/styles/global.css); the 1280
// content column is centred, columns wrap below 1200px. Field: src/scripts/scenes/FooterScene.ts.
// Content: src/config/footer.ts.
import Logo from "./Logo.astro";
import { FOOTER_COLUMNS, SOCIAL_LINKS } from "../config/footer";

interface Props {
  /** Blue aurora photo behind the ASCII field instead of plain black (Figma: S7 Footer (aurora)) */
  aurora?: boolean;
}
const { aurora = false } = Astro.props;

// Mono label used for "Social media" and the column titles
const label = "font-mono text-[12px]/4 uppercase tracking-[0.08em] text-[#8e8e93] md:text-[calc(12*var(--fx))]/[calc(16*var(--fx))]";
---

<footer
  data-footer
  class="relative overflow-hidden bg-black px-gutter-sm pt-24 pb-8 text-white md:px-[calc(40*var(--fx))] md:pt-[calc(170*var(--fx))] md:pb-[calc(41*var(--fx))]"
>
  {
    aurora && (
      // Figma: footer bg (aurora), 1920×1080 starting 560 above the footer's top and stretched to its bottom so its lower half shows
      <img
        src="/assets/images/software/hero-aurora.jpg"
        width="1920"
        height="1080"
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="pointer-events-none absolute inset-x-0 top-[-560px] h-[calc(100%+560px)] w-full max-w-none object-cover object-top max-md:left-1/2 max-md:w-[1920px] max-md:-translate-x-1/2 md:top-[calc(-560*var(--fx))] md:h-[calc(100%+560*var(--fx))]"
      />
    )
  }
  <canvas data-ref="field" aria-hidden="true" class="field pointer-events-none absolute inset-0 size-full"></canvas>

  <div class="relative mx-auto max-w-[calc(1280*var(--fx))]">
    <div class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:grid-cols-[calc(444*var(--fx))_calc(292*var(--fx))_calc(292*var(--fx))_1fr] lg:gap-0">
      <!-- Brand: wordmark, tagline, social accounts -->
      <div class="col-span-2 md:col-span-3 lg:col-span-1">
        <Logo variant="wordmark" class="block h-[30px] w-auto text-white md:h-[calc(30*var(--fx))]" />
        <p class="mt-5 text-[20px]/8 text-white/60 md:mt-[calc(20*var(--fx))] md:text-[calc(20*var(--fx))]/[calc(32*var(--fx))]">
          Intelligence, in your hands.
        </p>
        <p class={`mt-9 md:mt-[calc(36*var(--fx))] ${label}`}>Social media</p>
        <ul class="mt-[18px] flex gap-3 md:mt-[calc(18*var(--fx))] md:gap-[calc(12*var(--fx))]">
          {
            SOCIAL_LINKS.map((social) => (
              <li>
                <a href={social.href} aria-label={social.label} class="social">
                  <img src={social.icon} width="20" height="20" alt="" class="size-[calc(20*var(--fx))]" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Link columns -->
      {
        FOOTER_COLUMNS.map((column) => (
          <nav aria-label={column.title}>
            <p class={label}>{column.title}</p>
            <ul class="mt-[22px] flex flex-col gap-3 md:mt-[calc(22*var(--fx))] md:gap-[calc(12*var(--fx))]">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- Legal line under a divider -->
    <div
      class="mt-20 flex flex-col gap-2 border-t border-white/14 pt-6 text-[13px]/4 text-[#8e8e93] md:mt-[calc(173*var(--fx))] md:flex-row md:justify-between md:pt-[calc(23*var(--fx))] md:text-[calc(13*var(--fx))]/[calc(16*var(--fx))]"
    >
      <span>© 2026 Tokkey · Concept renders</span>
      <span>Own your intelligence.</span>
    </div>
  </div>
</footer>

<script>
  import { FooterScene } from "../scripts/scenes/FooterScene";
  const footer = document.querySelector<HTMLElement>("[data-footer]");
  if (footer) new FooterScene(footer);
</script>

<style>
  /* ASCII field fades in from the top and thins toward the bottom (mask from #ftc on main) */
  .field {
    mask-image: linear-gradient(
      180deg,
      transparent 0,
      #000 25%,
      rgb(0 0 0 / 90%) 52%,
      rgb(0 0 0 / 22%) 78%,
      rgb(0 0 0 / 14%) 100%
    );
  }

  /* Round glass button around each social icon */
  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(44 * var(--fx));
    height: calc(44 * var(--fx));
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 50%;
    background: rgb(255 255 255 / 6%);
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .social:hover {
    border-color: rgb(255 255 255 / 45%);
    background: rgb(255 255 255 / 12%);
  }

  .footer-link {
    color: rgb(242 242 242 / 82%);
    font-size: calc(16 * var(--fx));
    line-height: calc(24 * var(--fx));
    transition: color 0.2s;
  }
  .footer-link:hover {
    color: var(--color-white);
  }

  .social:focus-visible,
  .footer-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
