---
// Fixed site header: wordmark, primary links (hidden ≤ 900px), early-access CTA.
import Logo from "./Logo.astro";

// Primary nav links (same targets as the legacy page)
const links = [
  { label: "Software", href: "/software" },
  { label: "Models", href: "/models" },
  { label: "Pricing", href: "/pricing" },
  { label: "Dev Doc", href: "/devdoc" },
  { label: "FAQ", href: "/faq" },
];
---

<nav class="fixed inset-x-0 top-0 z-[60] flex h-header items-center border-b border-[#161618] bg-black px-4 text-white min-[901px]:px-12">
  <Logo variant="wordmark" class="block h-[30px] w-auto" />
  <ul class="mr-10 ml-auto hidden gap-9 text-[15px] min-[901px]:flex">
    {links.map((link) => <li><a href={link.href} class="opacity-72 hover:opacity-100">{link.label}</a></li>)}
  </ul>
  <a
    class="ml-auto inline-flex h-11 items-center rounded-full bg-white px-[22px] text-[14.5px] font-medium text-[#111] min-[901px]:ml-0"
    href="/software#early">Get early access</a
  >
</nav>
