---
// User comments section ("Real people. Local AI."): heading over a staggered wall of glass quote cards.
// Desktop shows three offset columns; tablet flows the cards into two columns, mobile into one.
// Reveal animation: src/scripts/scenes/CommentsScene.ts. Content: src/config/comments.ts.
import { COLUMN_OFFSETS, COMMENT_COLUMNS } from "../config/comments";
---

<section id="comments" data-comments class="relative overflow-hidden bg-black px-gutter-sm pt-20 pb-14 text-white md:px-[calc(40*var(--fx))] md:pt-[calc(80*var(--fx))] md:pb-[calc(56*var(--fx))]">
  <div class="mx-auto max-w-[calc(1392*var(--fx))] text-center">
    <p data-reveal class="text-body font-semibold text-[#a1a1a6] md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">User Comments</p>
    <h2 data-reveal class="mt-9 text-h2-sm font-bold md:mt-[calc(36*var(--fx))] md:text-[calc(64*var(--fx))]/[calc(72*var(--fx))]">
      <span class="text-chrome">Real people. Local AI</span><span class="period">.</span>
    </h2>
    <p data-reveal class="mx-auto mt-7 max-w-[calc(1000*var(--fx))] text-lead text-[#a1a1a6] md:mt-[calc(28*var(--fx))] md:text-[calc(24*var(--fx))]/[calc(32*var(--fx))]">
      A little key. A different way to work.<br class="max-md:hidden" /> For those who want their AI to stay theirs.
    </p>
  </div>

  <div class="relative mx-auto mt-12 max-w-[calc(1392*var(--fx))] md:mt-[calc(48*var(--fx))]">
    <!-- Soft blue glow behind the glass; it gives the cards' backdrop blur something to pick up -->
    <img
      src="/assets/images/comments/ambient-light.svg"
      width="1200"
      height="640"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute top-[calc(-24*var(--fx))] left-1/2 w-[calc(1200*var(--fx))] max-w-none -translate-x-1/2"
    />

    <div class="relative grid gap-6 md:grid-cols-2 md:gap-[calc(24*var(--fx))] lg:flex lg:min-h-[calc(592*var(--fx))] lg:justify-center">
      {
        COMMENT_COLUMNS.map((column, i) => (
          <div class="comment-column contents lg:flex lg:max-w-[calc(448*var(--fx))] lg:flex-1 lg:flex-col lg:gap-[calc(24*var(--fx))]" style={`--offset:calc(${COLUMN_OFFSETS[i]} * var(--fx))`}>
            {column.map((comment) => (
              <figure data-comment class:list={["comment-card", { featured: comment.featured }]}>
                <figcaption class="flex items-center gap-[calc(16*var(--fx))]">
                  <span class="avatar">{comment.initials}</span>
                  <span class="text-body md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">
                    <b class="block font-semibold text-white">{comment.role}</b>
                    <span class="block text-[#a1a1a6]">Example profile</span>
                  </span>
                </figcaption>
                <blockquote class="quote">{comment.quote}</blockquote>
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <p class="mt-14 text-center text-body text-[#8e8e93] md:mt-[calc(56*var(--fx))] md:text-[calc(16*var(--fx))]/[calc(24*var(--fx))]">Concept layout · Quotes and profiles are illustrative.</p>
</section>

<script>
  import { CommentsScene } from "../scripts/scenes/CommentsScene";
  const section = document.querySelector<HTMLElement>("[data-comments]");
  if (section) new CommentsScene(section);
</script>

<style>
  /* Desktop: push each column down by its offset to stagger the wall */
  @media (width >= 1200px) {
    .comment-column {
      padding-top: var(--offset);
    }
  }

  /* Glass card (Figma: Tokkey / User Comments / Glass card) */
  .comment-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: calc(32 * var(--fx));
    min-height: calc(248 * var(--fx));
    padding: calc(32 * var(--fx));
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: calc(29.644 * var(--fx));
    background: linear-gradient(157.45deg, rgb(255 255 255 / 13%) 0%, rgb(255 255 255 / 4%) 71.429%);
    /* Unprefixed only: the minifier adds -webkit- itself, and drops the unprefixed one if both are written */
    backdrop-filter: blur(calc(17.787 * var(--fx)));
    filter: drop-shadow(0 calc(35.573 * var(--fx)) calc(44.466 * var(--fx)) rgb(0 0 0 / 45%));
  }
  /* Featured card: taller, darker and opaque (no backdrop blur), brighter edge and a bigger quote */
  .comment-card.featured {
    min-height: calc(288 * var(--fx));
    border-color: rgb(255 255 255 / 45%);
    background: linear-gradient(154.26deg, rgb(70 70 82 / 92%) 0%, rgb(24 24 30 / 94%) 71.429%);
    backdrop-filter: none;
    filter: drop-shadow(0 calc(30 * var(--fx)) calc(30 * var(--fx)) rgb(0 0 0 / 45%));
  }

  .avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: calc(48 * var(--fx));
    height: calc(48 * var(--fx));
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: calc(16 * var(--fx));
    background: linear-gradient(143.13deg, rgb(255 255 255 / 20%) 0%, rgb(255 255 255 / 7%) 71.429%);
    color: #e5e5ea;
    font-size: calc(16 * var(--fx));
    font-weight: 600;
    line-height: calc(24 * var(--fx));
  }

  .quote {
    color: #f5f5f7;
    font-size: calc(24 * var(--fx));
    line-height: calc(32 * var(--fx));
  }
  .featured .quote {
    font-size: calc(32 * var(--fx));
    line-height: calc(40 * var(--fx));
  }
  /* Keep the designed line breaks once the three-column wall shows: cards scale with --fx, so from here up
     they always keep their designed width relative to the text */
  @media (width >= 1200px) {
    .quote {
      white-space: pre-line;
    }
  }
</style>
