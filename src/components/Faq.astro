---
// Homepage FAQ (prototype #faq): left-aligned "FAQ." heading over hairline-separated native <details> rows; the "+"
// turns into an accent "×" when open and, where the browser supports it, the answer slides open. Desktop sizes are
// Figma px via --fx. Content: src/config/faq.ts.
import { FAQ_ITEMS } from "../config/faq";
---

<section id="faq" class="faq bg-black text-white">
  <h2 class="heading font-medium">FAQ<span class="dot" aria-hidden="true"></span></h2>
  <div class="list">
    {
      FAQ_ITEMS.map(({ question, answer }, i) => (
        <details class="item" open={i === 0}>
          <summary class="question">
            {question}
            <span class="icon" aria-hidden="true">
              +
            </span>
          </summary>
          <p class="answer">{answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    padding: 80px var(--spacing-gutter-sm);
  }
  .heading {
    margin-bottom: 32px;
    font-size: var(--text-h2-sm);
    line-height: 44px;
    letter-spacing: -0.03em;
  }
  .list {
    border-top: 1px solid var(--color-hair);
  }
  .item {
    border-bottom: 1px solid var(--color-hair);
    interpolate-size: allow-keywords;
  }
  /* Slide the answer open / closed (progressive: browsers without ::details-content just toggle) */
  .item::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.35s ease,
      content-visibility 0.35s allow-discrete;
  }
  .item[open]::details-content {
    height: auto;
  }
  .question {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }
  .question::-webkit-details-marker {
    display: none;
  }
  .question:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .icon {
    flex: none;
    color: #8a8a90;
    transition:
      transform 0.25s ease,
      color 0.25s ease;
  }
  .item[open] .icon {
    transform: rotate(45deg);
    color: var(--color-accent);
  }
  .answer {
    padding: 0 32px 24px 0;
    font-size: 16px;
    line-height: 24px;
    color: rgb(255 255 255 / 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .item::details-content,
    .icon {
      transition: none;
    }
  }

  @media (width >= 768px) {
    .faq {
      padding: calc(80 * var(--fx)) calc(146 * var(--fx));
    }
    .heading {
      margin-bottom: calc(40 * var(--fx));
      font-size: calc(80 * var(--fx));
      line-height: calc(88 * var(--fx));
    }
    .question {
      font-size: calc(24 * var(--fx));
      line-height: 1.3;
    }
    .answer {
      font-size: calc(16 * var(--fx));
      line-height: calc(24 * var(--fx));
    }
  }
</style>
